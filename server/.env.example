# Railway automatically assigns PORT in production; default is 5000 for local dev
PORT=5000

# MongoDB Atlas Database Connection URI (Recommended for production on Railway)
# If not provided, fallback JSON storage (server/data/db.json) will be used
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/vendetta?retryWrites=true&w=majority

# Passcodes for access
ADMIN_PASSWORD=YK789
MEMBER_PASSWORD=takla

# Allowed Leader / Member Discord User IDs (comma-separated, optional)
ADMIN_DISCORD_IDS=879604109366394880
MEMBER_DISCORD_IDS=879604109366394880

