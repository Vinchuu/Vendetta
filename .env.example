# ==========================================
# FYB Gang System Environment Configuration
# ==========================================

# Server Port
PORT=5000

# Discord OAuth2 Application Credentials
# ----------------------------------------------------
# 1. Go to Discord Developer Portal: https://discord.com/developers/applications
# 2. Create a new Application and go to "OAuth2" section
# 3. Copy Client ID -> paste into DISCORD_CLIENT_ID
# 4. Copy Client Secret -> paste into DISCORD_CLIENT_SECRET
# 5. Under "Redirects", add: http://localhost:5000/api/auth/discord/callback
# ----------------------------------------------------
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:5000/api/auth/discord/callback

# Allowed Discord User IDs (Comma-Separated)
# ----------------------------------------------------
# 1. Leader / Admin Discord IDs (full control):
# Example: ADMIN_DISCORD_IDS=123456789012345678,987654321098765432
ADMIN_DISCORD_IDS=

# 2. Gang Member Discord IDs (member edit & arsenal order permissions):
# Example: MEMBER_DISCORD_IDS=112233445566778899,998877665544332211
MEMBER_DISCORD_IDS=

# Supabase Cloud Database (Optional for Cloud Realtime Database)
# ----------------------------------------------------
# 1. Create a free project at: https://supabase.com
# 2. Copy Project URL -> paste into VITE_SUPABASE_URL
# 3. Copy anon public API key -> paste into VITE_SUPABASE_ANON_KEY
# ----------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
