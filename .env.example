# Local realtime backend (no cloud API keys required)
PORT=5000

# MongoDB Atlas Database Connection URI (Optional: Leave blank to use local JSON file persistence)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/vendetta?retryWrites=true&w=majority

# Optional: override default leader / member passcodes
ADMIN_PASSWORD=YK789
MEMBER_PASSWORD=takla

# Allowed Leader / Member Discord User IDs (comma-separated, optional)
ADMIN_DISCORD_IDS=
MEMBER_DISCORD_IDS=

# Optional Discord login (only if you want Discord OAuth)
# VITE_DISCORD_CLIENT_ID=your_discord_client_id

# Leave empty in local dev — Vite proxies /api and /socket.io to PORT
# VITE_API_URL=http://localhost:5000

